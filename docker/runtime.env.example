# Fill in existing deployment values before use.
# DATABASE_URL=postgresql+asyncpg://user:password@postgresql-service:5432/everunfold
# REDIS_URL=redis://redis-service:6379/0
# CELERY_BROKER_URL=redis://redis-service:6379/1
# QUERY_CACHE_REDIS_URL=redis://query-cache:6379/0
# EVERUNFOLD_API_APPLICATION_MASTER_KEY=
# EVERUNFOLD_TOTP_MASTER_KEY=
# NEXTJS_TO_FASTAPI_WEB_MAIN_TOKEN=
# FASTAPI_TO_NEXTJS_WEB_MAIN_TOKEN=
# 容器内 API 进程监听 IP；公开 URL 在 CONFIG_FILE 指定的 YAML 的 BACKEND_BASE_URL。
# 使用 Compose 时，容器 API_PORT 由 docker/.env 中的 BACKEND_API_PORT 注入。
API_HOST=0.0.0.0
API_WORKERS=1
WORKER_POOL=solo
WORKER_CONCURRENCY=1
# Optional with WORKER_POOL=prefork: Celery scales between 1 and 4 child processes.
# WORKER_AUTOSCALE=4,1
WORKER_PREFETCH_MULTIPLIER=1
API_LOG_LEVEL=INFO
WORKER_LOG_LEVEL=WARNING
SCHEDULER_LOG_LEVEL=INFO
API_SHUTDOWN_TIMEOUT=30
