        "total_views": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Views"
        },
        "period_views": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period Views"
        },
        "daily": {
          "items": {
            "$ref": "#/$defs/WorkspaceViewPoint"
          },
          "title": "Daily",
          "type": "array"
        },
        "popular": {
          "items": {
            "$ref": "#/$defs/WorkspacePopularArticle"
          },
          "title": "Popular",
          "type": "array"
        },
        "all_time": {
          "items": {
            "$ref": "#/$defs/WorkspacePopularArticle"
          },
          "title": "All Time",
          "type": "array"
        },
        "security": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceAudit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceAudit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "days",
        "period_start",
        "period_end"
      ],
      "title": "WorkspaceAnalytics",
      "type": "object"
    },
    "WorkspaceAnalyticsQuery": {
      "additionalProperties": false,
      "properties": {
        "days": {
          "default": 7,
          "enum": [
            7,
            30,
            90
          ],
          "title": "Days",
          "type": "integer"
        }
      },
      "title": "WorkspaceAnalyticsQuery",
      "type": "object"
    },
    "WorkspaceAudit": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/WorkspaceAuditItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "count",
        "items"
      ],
      "title": "WorkspaceAudit",
      "type": "object"
    },
    "WorkspaceAuditItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "action",
        "actor",
        "created_at"
      ],
      "title": "WorkspaceAuditItem",
      "type": "object"
    },
    "WorkspaceCardPlacement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "width": {
          "default": 3,
          "enum": [
            1,
            2,
            3,
            6
          ],
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "WorkspaceCardPlacement",
      "type": "object"
    },
    "WorkspaceItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "href": {
          "title": "Href",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "scheduled_for": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled For"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "id",
        "title",
        "href",
        "updated_at"
      ],
      "title": "WorkspaceItem",
      "type": "object"
    },
    "WorkspaceLayoutValue": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "cards": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/WorkspaceCardPlacement"
              },
              "maxItems": 48,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cards"
        }
      },
      "title": "WorkspaceLayoutValue",
      "type": "object"
    },
    "WorkspacePopularArticle": {
