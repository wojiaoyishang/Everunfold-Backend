        },
        "data": {
          "$ref": "#/$defs/ModerationCatalog"
        }
      },
      "required": [
        "data"
      ],
      "title": "PublicResponse[ModerationCatalog]",
      "type": "object"
    },
    "PublicResponse_WorkspaceAnalytics_": {
      "additionalProperties": false,
      "properties": {
        "success": {
          "default": true,
          "title": "Success",
          "type": "boolean"
        },
        "code": {
          "default": 200,
          "title": "Code",
