    "WorkspaceAnalytics": {
      "additionalProperties": false,
      "properties": {
        "days": {
          "title": "Days",
          "type": "integer"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "period_start": {
          "format": "date-time",
          "title": "Period Start",
          "type": "string"
