  "required": [
    "query",
    "moderate",
    "edit",
    "catalog",
    "result",
    "workspace",
    "workspace_layout_input",
    "workspace_layout",
    "workspace_analytics_query",
    "workspace_analytics"
  ],
  "title": "OperationsContract",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-everunfold-contract-version": "1.3.0",
  "x-everunfold-operations": [
    {
      "name": "readWorkspace",
      "path": "/v1/admin/workspace",
      "method": "GET",
      "response": "workspace"
    },
    {
      "name": "queryWorkspaceAnalytics",
      "path": "/v1/admin/workspace/analytics",
      "method": "POST",
      "input": "workspace_analytics_query",
      "response": "workspace_analytics"
    },
    {
      "name": "saveWorkspaceLayout",
      "path": "/v1/admin/workspace/layout",
      "method": "POST",
      "input": "workspace_layout_input",
      "response": "workspace_layout"
    },
    {
      "name": "queryComments",
      "path": "/v1/admin/comments/query",
      "method": "POST",
      "input": "query",
      "response": "catalog"
    },
    {
      "name": "moderateComments",
      "path": "/v1/admin/comments/moderate",
      "method": "POST",
      "input": "moderate",
      "response": "result"
    },
    {
      "name": "editComment",
      "path": "/v1/admin/comments/edit",
      "method": "POST",
      "input": "edit",
      "response": "result"
    },
    {
      "name": "replyToComment",
      "path": "/v1/admin/comments/reply",
      "method": "POST",
      "input": "edit",
      "response": "result"
    }
  ]
}
