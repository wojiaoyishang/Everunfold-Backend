  "additionalProperties": false,
  "properties": {
    "query": {
      "$ref": "#/$defs/CommentQuery"
    },
    "moderate": {
      "$ref": "#/$defs/ModerateComments"
    },
    "edit": {
      "$ref": "#/$defs/EditComment"
    },
    "catalog": {
      "$ref": "#/$defs/PublicResponse_ModerationCatalog_"
    },
    "result": {
      "$ref": "#/$defs/PublicResponse_CommentResult_"
    },
    "workspace": {
      "$ref": "#/$defs/PublicResponse_WorkspaceSummary_"
    },
    "workspace_layout_input": {
      "$ref": "#/$defs/WorkspaceLayoutValue"
    },
    "workspace_layout": {
      "$ref": "#/$defs/PublicResponse_WorkspaceLayoutValue_"
    },
    "workspace_analytics_query": {
      "$ref": "#/$defs/WorkspaceAnalyticsQuery"
    },
    "workspace_analytics": {
      "$ref": "#/$defs/PublicResponse_WorkspaceAnalytics_"
    }
