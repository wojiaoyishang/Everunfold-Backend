{
  "$defs": {
    "ComponentDocument": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/ComponentNode"
          },
          "maxItems": 300,
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "version",
        "nodes"
      ],
      "title": "ComponentDocument",
      "type": "object"
    },
    "ComponentNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_.-]{0,63}$",
          "title": "Type",
          "type": "string"
        },
        "props": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxProperties": 64,
          "title": "Props",
          "type": "object"
        },
        "css": {
          "default": "",
          "maxLength": 4096,
          "title": "Css",
          "type": "string"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/ComponentNode"
          },
          "maxItems": 300,
          "title": "Children",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/ComponentParameter"
          },
          "maxProperties": 32,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "props"
      ],
      "title": "ComponentNode",
      "type": "object"
    },
    "ComponentParameter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "keep_default": {
          "default": true,
          "title": "Keep Default",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "ComponentParameter",
      "type": "object"
    },
    "ContentBlock": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "markdown",
            "html"
          ],
          "title": "Type",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "content"
      ],
      "title": "ContentBlock",
      "type": "object"
    },
    "ContentTranslation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "path": {
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "access": {
          "default": "public",
          "enum": [
            "public",
            "password",
            "scheduled",
            "captcha"
          ],
          "title": "Access",
          "type": "string"
        },
        "is_original": {
          "default": false,
          "title": "Is Original",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "language",
        "path"
      ],
      "title": "ContentTranslation",
      "type": "object"
    },
    "FontInfo": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "title": "Family",
          "type": "string"
        },
        "style": {
          "enum": [
            "normal",
            "italic"
          ],
          "title": "Style",
          "type": "string"
        },
        "weight_min": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Weight Min",
          "type": "integer"
        },
        "weight_max": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Weight Max",
          "type": "integer"
        },
        "format": {
          "enum": [
            "woff2",
            "woff",
            "truetype",
            "opentype"
          ],
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "family",
        "style",
        "weight_min",
        "weight_max",
        "format"
      ],
      "title": "FontInfo",
      "type": "object"
    },
    "JsonValue": {},
    "MediaURL": {
      "additionalProperties": false,
      "properties": {
        "original": {
          "title": "Original",
          "type": "string"
        },
        "webp": {
          "default": "",
          "title": "Webp",
          "type": "string"
        },
        "font": {
          "anyOf": [
            {
              "$ref": "#/$defs/FontInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "original"
      ],
      "title": "MediaURL",
      "type": "object"
    },
    "TaxonomyDTO": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "slug": {
          "title": "Slug",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "category",
            "tag"
          ],
          "title": "Kind",
          "type": "string"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "kind",
        "count"
      ],
      "title": "TaxonomyDTO",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allow_indexing": {
      "default": true,
      "title": "Allow Indexing",
      "type": "boolean"
    },
    "seo_title": {
      "default": "",
      "title": "Seo Title",
      "type": "string"
    },
    "seo_description": {
      "default": "",
      "title": "Seo Description",
      "type": "string"
    },
    "seo_canonical_path": {
      "default": "",
      "maxLength": 500,
      "title": "Seo Canonical Path",
      "type": "string"
    },
    "seo_share_title": {
      "default": "",
      "maxLength": 200,
      "title": "Seo Share Title",
      "type": "string"
    },
    "seo_share_description": {
      "default": "",
      "maxLength": 500,
      "title": "Seo Share Description",
      "type": "string"
    },
    "seo_image_alt": {
      "default": "",
      "maxLength": 500,
      "title": "Seo Image Alt",
      "type": "string"
    },
    "seo_max_snippet": {
      "anyOf": [
        {
          "maximum": 5000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seo Max Snippet"
    },
    "seo_image_preview": {
      "anyOf": [
        {
          "enum": [
            "none",
            "standard",
            "large"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seo Image Preview"
    },
    "seo_structured_data": {
      "anyOf": [
        {
          "const": false,
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seo Structured Data"
    },
    "article_layout": {
      "default": "inherit",
      "enum": [
        "inherit",
        "wide",
        "sidebar"
      ],
      "title": "Article Layout",
      "type": "string"
    },
    "show_toc": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Show Toc"
    },
    "show_share": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Show Share"
    },
    "show_related": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Show Related"
    },
    "show_afterword": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Show Afterword"
    },
    "share_image_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Share Image Url"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "type": {
      "enum": [
        "article",
        "shuoshuo",
        "page"
      ],
      "title": "Type",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "path": {
      "pattern": "^/",
      "title": "Path",
      "type": "string"
    },
    "excerpt": {
      "title": "Excerpt",
      "type": "string"
    },
    "show_encrypted_excerpt": {
      "default": false,
      "title": "Show Encrypted Excerpt",
      "type": "boolean"
    },
    "hide_card_excerpt": {
      "default": false,
      "title": "Hide Card Excerpt",
      "type": "boolean"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "translation_group_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Translation Group Id"
    },
    "translations": {
      "items": {
        "$ref": "#/$defs/ContentTranslation"
      },
      "title": "Translations",
      "type": "array"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "author": {
      "title": "Author",
      "type": "string"
    },
    "cover_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cover Url"
    },
    "reading_minutes": {
      "minimum": 0,
      "title": "Reading Minutes",
      "type": "integer"
    },
    "word_count": {
      "minimum": 0,
      "title": "Word Count",
      "type": "integer"
    },
    "categories": {
      "items": {
        "$ref": "#/$defs/TaxonomyDTO"
      },
      "title": "Categories",
      "type": "array"
    },
    "tags": {
      "items": {
        "$ref": "#/$defs/TaxonomyDTO"
      },
      "title": "Tags",
      "type": "array"
    },
    "comment_count": {
      "minimum": 0,
      "title": "Comment Count",
      "type": "integer"
    },
    "pinned": {
      "title": "Pinned",
      "type": "boolean"
    },
    "content": {
      "items": {
        "$ref": "#/$defs/ContentBlock"
      },
      "title": "Content",
      "type": "array"
    },
    "edit_mode": {
      "default": "blocks",
      "enum": [
        "blocks",
        "components"
      ],
      "title": "Edit Mode",
      "type": "string"
    },
    "component_document": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComponentDocument"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "media_urls": {
      "additionalProperties": {
        "$ref": "#/$defs/MediaURL"
      },
      "title": "Media Urls",
      "type": "object"
    },
    "extra_css": {
      "default": "",
      "maxLength": 16000,
      "title": "Extra Css",
      "type": "string"
    },
    "comments_open": {
      "title": "Comments Open",
      "type": "boolean"
    },
    "show_image_viewer": {
      "default": true,
      "title": "Show Image Viewer",
      "type": "boolean"
    },
    "show_glossary_tooltips": {
      "default": true,
      "title": "Show Glossary Tooltips",
      "type": "boolean"
    },
    "show_glossary_footnotes": {
      "default": true,
      "title": "Show Glossary Footnotes",
      "type": "boolean"
    },
    "reaction_count": {
      "minimum": 0,
      "title": "Reaction Count",
      "type": "integer"
    },
    "access": {
      "enum": [
        "public",
        "password",
        "scheduled",
        "captcha"
      ],
      "title": "Access",
      "type": "string"
    },
    "opens_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Opens At"
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "path",
    "excerpt",
    "language",
    "published_at",
    "updated_at",
    "author",
    "cover_url",
    "reading_minutes",
    "word_count",
    "categories",
    "tags",
    "comment_count",
    "pinned",
    "content",
    "media_urls",
    "comments_open",
    "reaction_count",
    "access",
    "opens_at"
  ],
  "title": "ContentPresentation",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-everunfold-contract-version": "0.2.0-preview.10",
  "description": "Draft presentation contract. No HTTP endpoint or database migration is installed. Locked records omit body, excerpt and media. Viewer-specific state is separate."
}
