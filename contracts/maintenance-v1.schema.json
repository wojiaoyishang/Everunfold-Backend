    },
    "import_request": {
      "$ref": "#/$defs/MaintenanceImportRequest"
    },
    "apply_request": {
      "$ref": "#/$defs/MaintenanceApplyRequest"
    },
    "preview": {
      "$ref": "#/$defs/PublicResponse_MaintenancePreview_"
    },
    "receipt": {
