    "GlossaryFields": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "anyOf": [
            {
              "const": "*",
              "type": "string"
            },
            {
              "maxLength": 32,
              "minLength": 2,
              "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
              "type": "string"
            }
          ],
          "default": "*",
          "title": "Language"
        },
        "slug": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Slug",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
